# Cabeçalhos aplicados pelo Cloudflare Pages.
#
# Estratégia de cache: o HTML precisa estar sempre fresco (é onde os preços
# vivem), enquanto imagens, CSS e JS podem ficar guardados por muito tempo.
# Quando um desses arquivos mudar, troque o nome dele (fotos) ou o ?v= no
# index.html (CSS e JS) — assim o navegador busca a versão nova sem esperar
# o cache expirar.
#
# O cache longo de /assets/* e /vendor/* só vale para arquivo que EXISTE:
# para arquivo inexistente, o _worker.js devolve 404 com "no-cache" (antes,
# o Pages respondia o index.html com 200 e este "immutable" fazia o navegador
# guardar a página inicial no lugar da foto por um ano). As páginas do site
# (/passeios, /reservar…) saem do _worker.js com o cabeçalho de "/" abaixo;
# a página 404 sai com "no-cache".

/*
  ! Access-Control-Allow-Origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Biblioteca de terceiros com a versão no nome do arquivo: nunca muda em silêncio.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/estilo.css
  Cache-Control: public, max-age=86400

/app.js
  Cache-Control: public, max-age=86400

# Também versionados por ?v= no index.html, como o app.js.
/motion.js
  Cache-Control: public, max-age=86400

/pescaria-galeria.js
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/manifest.json
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
